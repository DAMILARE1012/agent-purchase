{
  "realm": "${KEYCLOAK_REALM}",
  "displayName": "Mandate Gate",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "shopper", "description": "Signs mandates, approves carts and sees their purchases" },
      { "name": "seller", "description": "Manages a store's catalog, bank accounts, orders and refunds" },
      { "name": "analyst", "description": "Support analyst: reviews blocked carts, disputes and sellers" },
      { "name": "ops", "description": "Ops and LLM engineer: agent versions, evaluations, traces and the platform ledger" },
      { "name": "admin", "description": "Verifies and suspends sellers, manages users" }
    ]
  },
  "defaultRole": {
    "name": "default-roles-${KEYCLOAK_REALM}",
    "composite": true,
    "composites": { "realm": ["offline_access", "uma_authorization", "shopper"] }
  },
  "clients": [
    {
      "clientId": "${OIDC_CLIENT_ID}",
      "name": "Mandate Gate web app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${WEB_PUBLIC_URL}/auth/callback"],
      "webOrigins": ["${WEB_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "scan-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${OIDC_AUDIENCE}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "scan-cli",
      "name": "Development and test client (password grant). Do not enable in production.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "scan-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${OIDC_AUDIENCE}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "0b4a8f0e-5c1a-4c1e-9a53-1d1f00000001",
      "username": "sam",
      "email": "sam@example.com",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Carter",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["default-roles-${KEYCLOAK_REALM}"]
    },
    {
      "id": "0b4a8f0e-5c1a-4c1e-9a53-1d1f00000002",
