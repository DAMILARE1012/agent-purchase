# Scan-to-Confirm configuration.
# Copy to .env and adjust. docker compose reads .env automatically, and every
# service (Postgres, Keycloak, API, web) takes its settings from here.
# Values marked CHANGE are development defaults: replace them outside your laptop.

# ---- Public URLs (what a browser uses) ---------------------------------------
# If you change a port, change the matching URL too.
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
API_PORT=8000
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# ---- Postgres -------------------------------------------------------------------
# Host port; the containers use 5432 internally.
POSTGRES_PORT=5433
POSTGRES_DB=scan
POSTGRES_USER=scan
# CHANGE
POSTGRES_PASSWORD=scan
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
# CHANGE
KEYCLOAK_DB_PASSWORD=keycloak

# ---- Keycloak (identity provider) -----------------------------------------------
KEYCLOAK_ADMIN_USER=admin
# CHANGE
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=scan-to-confirm
OIDC_CLIENT_ID=scan-web
# CHANGE (e.g. openssl rand -hex 32)
OIDC_CLIENT_SECRET=scan-web-dev-secret
OIDC_AUDIENCE=scan-api
# Password for the seeded demo users (sam, rita, ada, jordan, morgan, olivia).
DEMO_USER_PASSWORD=demo1234

# ---- API ----------------------------------------------------------------------------
# Sandbox mode: welcome credit for new users, demo scenarios, simulated payment rail, data reset.
SANDBOX_MODE=true
# In cents: 50000 = $500.00
WELCOME_CREDIT_MINOR=50000
# Salt for the payee hash inside signed receipts. Changing it invalidates existing receipts.
# CHANGE
PAYEE_HASH_SALT=dev-payee-salt

# ---- Inter-bank network ---------------------------------------------------------
# This platform's bank code and name on the network.
PLATFORM_BANK_CODE=990
PLATFORM_BANK_NAME=Scan-to-Confirm
# The sandbox payment switch (services/switch).
SWITCH_PORT=8100
# CHANGE: the platform authenticates to the switch with this key.
SWITCH_API_KEY=dev-switch-api-key
# CHANGE: the switch signs webhooks to the platform with this secret.
SWITCH_WEBHOOK_SECRET=dev-switch-webhook-secret
# Sandbox timing: how long a "timed out" transfer stays pending, and when a ".66" transfer is reversed.
SWITCH_PENDING_SECONDS=30
SWITCH_REVERSAL_SECONDS=60

# ---- Web ----------------------------------------------------------------------------
# Shows sandbox panels and demo hints in the UI (baked in at build time).
NEXT_PUBLIC_DEMO_MODE=true
# Serves mandates, runs, carts, purchases, sellers and ops data from in-browser mock data
# (web/src/mocks) until the backend has those endpoints. Real endpoints are never mocked.
NEXT_PUBLIC_API_MOCKS=true
