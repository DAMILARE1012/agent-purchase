# Scan-to-Confirm configuration.
# Copy to .env and adjust. docker compose reads .env automatically, and every
# service (Postgres, Keycloak, API, web) takes its settings from here.
# Values marked CHANGE are development defaults: replace them outside your laptop.

# ---- Public URLs (what a browser uses) ---------------------------------------
# If you change a port, change the matching URL too.
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
API_PORT=8000
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# ---- Postgres -------------------------------------------------------------------
# Host port; the containers use 5432 internally.
POSTGRES_PORT=5433
POSTGRES_DB=scan
POSTGRES_USER=scan
# CHANGE
POSTGRES_PASSWORD=scan
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
# CHANGE
KEYCLOAK_DB_PASSWORD=keycloak

# ---- Keycloak (identity provider) -----------------------------------------------
KEYCLOAK_ADMIN_USER=admin
# CHANGE
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=scan-to-confirm
OIDC_CLIENT_ID=scan-web
# CHANGE (e.g. openssl rand -hex 32)
OIDC_CLIENT_SECRET=scan-web-dev-secret
OIDC_AUDIENCE=scan-api
# Password for the seeded demo users (sam, rita, ada, jordan, morgan, olivia).
DEMO_USER_PASSWORD=demo1234

# ---- API ----------------------------------------------------------------------------
# Sandbox mode: welcome credit for new users, demo scenarios, simulated payment rail, data reset.
SANDBOX_MODE=true
# In kobo: 50000000 = ₦500,000 (the ledger is in naira since M7)
WELCOME_CREDIT_MINOR=50000000
# Salt for the payee hash inside signed receipts. Changing it invalidates existing receipts.
# CHANGE
PAYEE_HASH_SALT=dev-payee-salt

# ---- Inter-bank network ---------------------------------------------------------
# This platform's bank code and name on the network.
PLATFORM_BANK_CODE=990
PLATFORM_BANK_NAME=Scan-to-Confirm
# The sandbox payment switch (services/switch).
SWITCH_PORT=8100
# CHANGE: the platform authenticates to the switch with this key.
SWITCH_API_KEY=dev-switch-api-key
# CHANGE: the switch signs webhooks to the platform with this secret.
SWITCH_WEBHOOK_SECRET=dev-switch-webhook-secret
# Sandbox timing: how long a "timed out" transfer stays pending, and when a ".66" transfer is reversed.
SWITCH_PENDING_SECONDS=30
SWITCH_REVERSAL_SECONDS=60

# ---- Sandbox marketplace (sellers, catalogs, signed carts) ------------------------
MARKETPLACE_PORT=8200
# What an agent follows for catalog images. Change with the port.
MARKETPLACE_PUBLIC_URL=http://localhost:8200
# CHANGE: the platform calls the marketplace's registry and label endpoints with this key.
MARKETPLACE_API_KEY=dev-marketplace-api-key
# CHANGE: sandbox sellers' signing keys are derived from this secret.
MARKETPLACE_KEY_SEED=dev-marketplace-key-seed

# ---- AI shopper: LLM gateway and workers (M5) -------------------------------------
# Your Groq API key. Leave empty to use the scripted sandbox provider (not a model).
# CHANGE: never commit a real key; .env is git-ignored.
GROQ_API_KEY=
# auto (Groq if a key is set, else sandbox) | groq | sandbox
LLM_PROVIDER=auto
# Shared across all workers and users. Set these to your Groq account's limits (the Groq console's
# Limits page, or the 429 error, shows them). With both an input and a total token limit, use the lower.
LLM_REQUESTS_PER_MINUTE=30
LLM_TOKENS_PER_MINUTE=60000
# Share of capacity kept for runs a shopper is watching.
LLM_INTERACTIVE_RESERVE=0.2
LLM_USER_DAILY_TOKENS=300000
# Evaluations (python -m app.evals) have their own daily token budget. Keep it well under the Groq account's daily
# limit for the model (200,000 tokens a day for qwen/qwen3.8-27b on this account), so shoppers keep capacity.
LLM_EVAL_DAILY_TOKENS=120000
# Runs each worker container works on at once.
WORKER_CONCURRENCY=8
# How long one run may take, including waiting for model capacity.
AGENT_RUN_TIMEOUT_SECONDS=300

# ---- Passkeys (M6) ------------------------------------------------------------------
# Passkeys belong to the web app's host name (the browser enforces it).
WEBAUTHN_RP_ID=localhost
# Sandbox only: lets automated tests (the scan-cli client) sign mandates with a labelled test signature.
# CHANGE: must be false anywhere real.
ALLOW_TEST_SIGNATURES=true

# ---- Web ----------------------------------------------------------------------------
# Shows sandbox panels and demo hints in the UI (baked in at build time).
NEXT_PUBLIC_DEMO_MODE=true
# Serves mandates, runs, carts, purchases, sellers and ops data from in-browser mock data
# (web/src/mocks) until the backend has those endpoints. Real endpoints are never mocked.
NEXT_PUBLIC_API_MOCKS=true
